{
  // The system under test: the local Ollama setup (free, so it can run many times a day).
  "AI": {
    "Provider": "OpenAICompatible",
    "Model": "qwen2.5:3b",
    "Endpoint": "http://localhost:11434/v1",
    "TimeoutSeconds": 300,
    "MaxHistoryMessages": 20,
    "Temperature": 0
  },
  "Embedding": {
    "Provider": "OpenAICompatible",
    "Model": "bge-m3",
    "Endpoint": "http://localhost:11434/v1",
    "Dimensions": 1024
  },
  "Rag": {
    "DocumentsPath": "Data/Policies",
    "TopK": 3,
    "Mode": "Always",
    "MinScore": 0.40,
    "Store": "InMemory"
  },
  // The judge must be stronger than the model it grades. ApiKey falls back to AI:ApiKey (User Secrets).
  "Judge": {
    "Provider": "Gemini",
    "Model": "gemini-3.5-flash",
    "TimeoutSeconds": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Extensions.AI": "Critical"
    }
  }
}
